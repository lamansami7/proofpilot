{
  "expo": {
    "name": "ProofPilot",
    "slug": "proofpilot",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proofpilot.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.proofpilot.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#193831"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose receipt and warranty images to attach to your purchases.",
          "cameraPermission": "Photograph a receipt to attach it to a purchase.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-secure-store"
    ],
    "scheme": "proofpilot",
    "icon": "./assets/icon.png",
    "web": {
      "name": "ProofPilot",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "35a5ac4e-462a-46f9-85a7-087ffffdb41f"
      }
    },
    "owner": "lamansami7"
  }
}
