# Public, embedded client configuration. Leave cloud keys empty for local-only use.
# Never place a service-role, AI provider key, SMTP password or signing secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Production web authentication redirect URL. Must match a Supabase allowed redirect URL.
# Set to https://get-proofpilot.lovable.app for production.
# Leave blank for local development (uses window.location.origin automatically).
# `npm run check:release` rejects non-HTTPS, credentials, query strings, fragments
# and localhost here. This value must be listed in Supabase Auth redirect URLs.
EXPO_PUBLIC_AUTH_REDIRECT_URL=
# Enable only after deploying and live-testing the delete-account Edge Function.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
# Optional: https://YOUR_PROJECT.supabase.co/functions/v1/proofpilot-ai
# Must be on the same Supabase project as EXPO_PUBLIC_SUPABASE_URL.
# Leave blank until AI backend, quotas, provider billing and consent are verified.
# A blank value means AI is intentionally disabled and is a valid release state.
EXPO_PUBLIC_PROOFPILOT_AI_ENDPOINT=
# Operator-approved public HTTPS privacy policy and PRIVATE support email address.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Optional. How long a signed-in session may take to restore before a retryable
# error is shown. Accepts 5000-60000 ms; anything else falls back to 30000.
EXPO_PUBLIC_SESSION_RESTORE_TIMEOUT_MS=
