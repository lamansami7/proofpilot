# Public client configuration, embedded at Expo build time. Never put provider
# secrets, Supabase service-role keys, passwords or signing keys here.
# Empty values run local-only. Fresh installations have no sample records.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL trusted HTTPS backend; leave empty until deployed and verified.
# Requires Supabase sign-in. The client sends the user's JWT in Authorization.
# POST /purchase-question and POST /claim-draft must validate JWTs server-side,
# bound input/output, enforce persistent per-account quotas and cost limits,
# and keep provider secrets/logged content server-side. No backend is deployed
# or included in this repository. Do not use a provider's API URL directly.
EXPO_PUBLIC_PROOFPILOT_AI_ENDPOINT=
