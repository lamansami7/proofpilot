# ProofPilot environment configuration
# Copy this file to .env and fill in the values. The app runs without them
# in local-first mode (on-device storage, no cloud sync, no AI answers).

# Supabase — enables sign-in and the cloud schema in /supabase/migrations.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Secure AI backend you operate (never put vendor API keys in this app).
# Expected endpoints: POST /purchase-question, POST /claim-draft
EXPO_PUBLIC_PROOFPILOT_AI_ENDPOINT=
